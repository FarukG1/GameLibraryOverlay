<Window x:Class="GameLibrary.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameLibrary.App"
        Title="Game Library" Foreground="#EDF1F7" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Width="1280" Height="800" PreviewKeyDown="OnKeyDown">
  <Window.Resources>
    <Style x:Key="BareItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CardItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,14,0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Padding="24,16"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="44,30,36,20" Background="Transparent"><Grid.ContextMenu><ContextMenu><MenuItem Header="All games" Click="AllClick"/><MenuItem Header="Favorites" Click="FavoritesClick"/><Separator/><MenuItem Header="Settings" Click="SettingsClick"/><MenuItem Header="Hide library" Click="CloseClick"/></ContextMenu></Grid.ContextMenu>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{StaticResource Accent}" Width="32" Height="32" CornerRadius="9" Margin="0,0,12,0"><TextBlock Text="G" Foreground="#182114" FontWeight="Bold" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="GAME LIBRARY" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
        <TextBlock Text=" /  YOUR COLLECTION" Foreground="{StaticResource Muted}" Margin="16,0,0,0" FontSize="11" VerticalAlignment="Center"/>
      </StackPanel>
      <Grid x:Name="SearchPanel" Grid.Column="1" Width="320" Visibility="Collapsed">
        <TextBox x:Name="Search" ToolTip="Search your games (Ctrl+F)" AutomationProperties.Name="Search games" TextChanged="SearchChanged"/>
        <TextBlock Text="Search games…" Foreground="{StaticResource Muted}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>

    </Grid>
    <Grid Grid.Row="1" Margin="0,32,0,26">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Ready when you are." FontSize="38" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0"/></StackPanel>

    </Grid>
    <ListBox x:Name="Rows" Grid.Row="2" ItemContainerStyle="{StaticResource BareItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
      <ListBox.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,0,0,25">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding CountLabel}" Foreground="{StaticResource Muted}" Margin="12,6,0,0" FontSize="12"/></StackPanel>
          <local:CarouselListBox Style="{StaticResource {x:Type ListBox}}" VirtualizingPanel.ScrollUnit="Pixel" ItemsSource="{Binding Cards}" Height="{Binding Height}" ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="0" PreviewMouseWheel="CarouselWheel" PreviewKeyDown="CarouselKeyDown" Loaded="CarouselLoaded">
            <local:CarouselListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></local:CarouselListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate>
              <Button Width="{Binding Width}" Focusable="False" Padding="0" Margin="0" Background="Transparent" Click="GameClick" ContextMenuOpening="GameContextMenu" ToolTip="{Binding Tooltip}">
                <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template><Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                <StackPanel>
                  <Grid x:Name="CoverArtwork" Height="{Binding CoverHeight}" RenderTransformOrigin="0.5,0.5"><Grid.Style><Style TargetType="Grid"><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Grid.Style><Grid Background="#263241"><Grid.Clip><RectangleGeometry Rect="{Binding CoverRect}" RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"/></Grid.Clip>
                    <StackPanel VerticalAlignment="Center" Margin="15"><TextBlock Text="{Binding Initial}" FontSize="52" FontWeight="Light" Foreground="#70829A" HorizontalAlignment="Center"/><TextBlock Text="{Binding Game.Name}" TextAlignment="Center" Foreground="#B6C4D6" Margin="0,10,0,0"/></StackPanel>
                    <local:CoverImage CoverPath="{Binding CoverPath}" Stretch="{Binding ImageStretch}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <local:CoverImage CoverPath="{Binding LogoPath}" Stretch="Uniform" Width="{Binding LogoWidth}" MaxHeight="95" Margin="16" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                    <Border Background="#D9171D26" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Padding="6,3"><TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
                  </Grid><Border CornerRadius="{Binding CoverCorners}" BorderThickness="2" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers>
<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/></DataTrigger>
<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/></DataTrigger>
</Style.Triggers></Style></Border.Style></Border></Grid>
                  <TextBlock Text="{Binding Game.Name}" FontWeight="SemiBold" FontSize="13" Margin="2,16,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </DataTemplate></ListBox.ItemTemplate>
          </local:CarouselListBox>
        </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="Empty" Grid.Row="2" Text="No games here yet. Add a Steam folder or a custom game in Settings." Foreground="{StaticResource Muted}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    <DockPanel Grid.Row="3" Margin="0,14,0,0"><local:InputHints DockPanel.Dock="Right" x:Name="ShortcutHint" TextElement.Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/></DockPanel>
  </Grid>
</Window>
